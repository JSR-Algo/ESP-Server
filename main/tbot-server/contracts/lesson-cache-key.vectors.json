{
  "contractVersion": 1,
  "contract": "lesson-cache-key + lesson SD pack path/basename parity (T5.1)",
  "producer": "tbot-backend/scripts/generate-lesson-contract-vectors.mjs",
  "consumers": [
    "tbot-backend  src/lessons/lesson-contract-vectors.spec.ts (vitest, blocking)",
    "robot/esp32-server main/tbot-server/tests/test_lesson_contract_vectors_parity.py (pytest, blocking)"
  ],
  "envelope": {
    "fields": [
      "code",
      "message",
      "retryable"
    ],
    "errorCodePattern": "^[a-z0-9][a-z0-9_]{0,63}$"
  },
  "limits": {
    "slugMaxBytes": 128,
    "cacheKeyMaxBytes": 205,
    "versionMaxDigits": 10,
    "assetBasenameMaxBytes": 200,
    "sdRoot": "/sdcard/tbot/lesson-assets"
  },
