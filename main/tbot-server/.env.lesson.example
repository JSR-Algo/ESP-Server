# Lesson runtime enablement example for the ESP server.
# Keep config.yaml voice_mode.type set to google_live for the on-robot Live session.

GOOGLE_API_KEY=<set-real-google-live-api-key>
LESSON_RUNTIME_ENABLED=true
COURSE_BACKEND_URL=<https://course-backend.example.com/v1>
LESSON_ASSET_ORIGIN_BASE=<https://assets.example.com/lessons>
TBOT_DEVICE_MINT_SECRET=<set-real-device-mint-secret>
