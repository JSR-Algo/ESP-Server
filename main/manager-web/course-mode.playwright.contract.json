    "globalSetup": "./e2e/lesson-studio/global-setup.cjs",
    "outputDir": "./output/playwright-e2e/results",
    "timeout": 60000,
    "expectTimeout": 10000,
    "fullyParallel": false,
    "workers": 1,
    "retries": 0,
    "reporter": [
      ["list"],
      ["html", { "outputFolder": "./output/playwright-e2e/report", "open": "never" }]
