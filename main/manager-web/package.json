{
  "name": "tbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "analyze": "cross-env ANALYZE=true vue-cli-service build",
    "test:course-admin-ui": "node scripts/check-course-admin-ui.mjs",
    "test:course-taxonomy": "node scripts/check-course-taxonomy.cjs",
    "test:course-taxonomy-browser": "node scripts/check-course-taxonomy-browser.mjs",
    "test:course-robot-e2e-ui": "node scripts/check-course-robot-e2e-ui-contracts.mjs",
    "test:tvideo-template": "node scripts/check-tvideo-template-contracts.mjs",
    "test:tvideo-journey-editor": "node scripts/check-tvideo-journey-editor.mjs",
    "test:tvideo-journey-browser": "node scripts/check-tvideo-journey-browser.mjs",
    "test:lesson-editor-ui": "node scripts/check-lesson-editor-ui-contracts.mjs",
    "test:lesson-assignment-ui": "node scripts/check-lesson-assignment-ui-contracts.mjs",
    "test:lesson-next-version": "node scripts/check-lesson-next-version.mjs",
    "test:flattened-cinematic-preview": "node scripts/check-flattened-cinematic-preview.mjs && node --test tests/unit/v5-preview-projection.test.cjs tests/unit/cinematic-media-lifecycle.test.mjs tests/unit/preview-dispatch.test.cjs tests/unit/mjpeg-mp4.test.mjs tests/unit/mjpeg-playback.test.mjs",
    "test:flattened-derivative-status": "node scripts/check-flattened-derivative-status.mjs",
    "test:lesson-sd-sync-ui": "node scripts/check-lesson-sd-sync-ui.mjs",
    "test:lesson-visual-selection": "node scripts/check-lesson-visual-selection.cjs && node --test tests/unit/course-mode-visual-selection.test.cjs tests/unit/course-mode-visual-editor.test.cjs",
    "test:lesson-builder-logic": "node scripts/check-lesson-builder-logic.cjs && node --test tests/unit/course-mode-editor.test.cjs tests/unit/admin-proxy-header.test.cjs",
    "test:rewards-admin-browser-runner": "node --test tests/scripts/rewards-admin-browser-lifecycle.test.mjs",
    "test:e2e:rewards-admin:live": "node scripts/run-rewards-admin-browser-e2e.mjs",
    "test:lesson-visual-library-ui": "node scripts/check-lesson-visual-library-ui.mjs",
    "test:lesson-visual-library-browser": "node scripts/check-lesson-visual-library-browser.mjs",
    "test:lesson-builder-browser": "node scripts/check-lesson-builder-browser.mjs",
    "test:mjpeg-replay-browser": "node scripts/check-mjpeg-replay-browser.cjs",
    "test:robot-preview-browser": "node --test tests/scripts/robot-preview-browser.test.mjs",
    "test:candidate-browser-harness": "node --test tests/scripts/candidate-browser-harness.test.mjs",
    "test:robot-preview-child-cleanup": "node scripts/check-robot-preview-screenshots.mjs --test-child-cleanup",
    "test:robot-preview-spawn-cleanup": "node scripts/check-robot-preview-screenshots.mjs --test-spawn-cleanup",
    "test:robot-preview-runtime-exit-cleanup": "node scripts/check-robot-preview-screenshots.mjs --test-runtime-exit-cleanup",
    "test:robot-preview-operation-timeout-cleanup": "node scripts/check-robot-preview-screenshots.mjs --test-operation-timeout-cleanup",
    "test:robot-preview-lifecycle": "npm run test:robot-preview-child-cleanup && npm run test:robot-preview-spawn-cleanup && npm run test:robot-preview-runtime-exit-cleanup && npm run test:robot-preview-operation-timeout-cleanup",
    "test:robot-preview-candidate-lifecycle": "node scripts/check-robot-preview-screenshots.mjs --test-runtime-exit-cleanup --candidate-browser && node scripts/check-robot-preview-screenshots.mjs --test-operation-timeout-cleanup --candidate-browser",
    "test:nest-auth-mode": "node scripts/check-nest-auth-mode.mjs",
    "test:admin-proxy-key-wiring": "node scripts/check-admin-proxy-key-wiring.mjs",
    "test:header-navigation-layout": "node scripts/check-header-navigation-layout.mjs",
    "test:lesson-studio-compose": "node --test scripts/lesson-studio-compose.test.cjs scripts/lesson-studio-e2e-environment.test.cjs scripts/reset-lesson-studio-e2e-state.test.cjs",
    "test:lesson-studio": "npm run test:nest-auth-mode && npm run test:course-taxonomy && npm run test:lesson-studio-compose && node scripts/check-login-navigation-race.cjs && node scripts/check-lesson-rollout-capabilities.mjs && npm run test:lesson-next-version && npm run test:lesson-assignment-ui && npm run test:lesson-visual-library-ui && npm run test:candidate-browser-harness && npm run test:lesson-visual-library-browser && npm run test:lesson-builder-logic && node scripts/check-lesson-step-editor-state.cjs && npm run test:lesson-builder-browser && npm run test:course-taxonomy-browser && npm run test:tvideo-journey-browser && node scripts/check-canonical-demo-ui.mjs && npm run test:flattened-derivative-status && npm run test:flattened-cinematic-preview && node scripts/check-robot-lesson-preview.mjs && npm run test:robot-preview-browser && npm run test:robot-preview-lifecycle && npm run test:robot-preview-candidate-lifecycle && node scripts/check-robot-preview-screenshots.mjs && npm run test:mjpeg-replay-browser",
    "test:web-cache-policy": "node scripts/check-web-cache-policy.mjs",
    "test:e2e:lesson-studio:reset": "node scripts/reset-lesson-studio-e2e-state.cjs",
    "test:e2e:lesson-studio:reset:test": "node --test scripts/reset-lesson-studio-e2e-state.test.cjs",
    "test:e2e:lesson-studio": "playwright test --config=playwright.lesson-studio.config.js",
    "test:e2e:course-mode": "playwright test --config=playwright.config.js",
    "test:course-mode:assignment-fixture": "node --test scripts/task4-assignment-fixture.test.cjs",
    "test:e2e:course-mode:assignment:new": "node scripts/run-task4-assignment-phase.cjs new",
    "test:e2e:course-mode:assignment:rollback": "node scripts/run-task4-assignment-phase.cjs rollback"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "core-js": "^3.41.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "element-ui": "^2.15.14",
    "normalize.css": "^8.0.1",
    "opus-decoder": "^0.7.7",
    "opus-recorder": "^8.0.5",
    "sm-crypto": "^0.5.4",
    "vue": "^2.6.14",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@playwright/test": "1.60.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "compression-webpack-plugin": "^12.0.0",
    "sass": "^1.32.7",
    "sass-loader": "^12.0.0",
    "vue-template-compiler": "2.6.14",
    "webpack-bundle-analyzer": "^4.10.2",
    "workbox-webpack-plugin": "^7.4.1",
    "ws": "7.5.13"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.vue"
  ]
}
