{
  "name": "tbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "analyze": "cross-env ANALYZE=true vue-cli-service build",
    "test:course-admin-ui": "node scripts/check-course-admin-ui.mjs",
    "test:course-robot-e2e-ui": "node scripts/check-course-robot-e2e-ui-contracts.mjs",
    "test:tvideo-template": "node scripts/check-tvideo-template-contracts.mjs",
    "test:lesson-editor-ui": "node scripts/check-lesson-editor-ui-contracts.mjs",
    "test:lesson-sd-sync-ui": "node scripts/check-lesson-sd-sync-ui.mjs",
    "test:lesson-builder-logic": "node scripts/check-lesson-builder-logic.cjs",
    "test:rewards-admin-browser-runner": "node --test tests/scripts/rewards-admin-browser-lifecycle.test.mjs",
    "test:e2e:rewards-admin:live": "node scripts/run-rewards-admin-browser-e2e.mjs",
    "test:lesson-visual-library-ui": "node scripts/check-lesson-visual-library-ui.mjs",
    "test:lesson-visual-library-browser": "node scripts/check-lesson-visual-library-browser.mjs",
    "test:lesson-builder-browser": "node scripts/check-lesson-builder-browser.mjs",
    "test:nest-auth-mode": "node scripts/check-nest-auth-mode.mjs",
    "test:lesson-studio-compose": "node --test scripts/lesson-studio-compose.test.cjs scripts/lesson-studio-e2e-environment.test.cjs scripts/reset-lesson-studio-e2e-state.test.cjs",
    "test:lesson-studio": "npm run test:nest-auth-mode && npm run test:lesson-studio-compose && node scripts/check-login-navigation-race.cjs && node scripts/check-lesson-rollout-capabilities.mjs && npm run test:lesson-visual-library-ui && npm run test:lesson-visual-library-browser && npm run test:lesson-builder-logic && node scripts/check-lesson-step-editor-state.cjs && npm run test:lesson-builder-browser && node scripts/check-canonical-demo-ui.mjs && node scripts/check-robot-lesson-preview.mjs && node scripts/check-robot-preview-screenshots.mjs",
    "test:web-cache-policy": "node scripts/check-web-cache-policy.mjs",
    "test:e2e:lesson-studio:reset": "node scripts/reset-lesson-studio-e2e-state.cjs",
    "test:e2e:lesson-studio:reset:test": "node --test scripts/reset-lesson-studio-e2e-state.test.cjs",
    "test:e2e:lesson-studio": "playwright test --config=playwright.config.js"
  },
  "dependencies": {
    "core-js": "^3.41.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "element-ui": "^2.15.14",
    "flyio": "^0.6.14",
    "normalize.css": "^8.0.1",
    "opus-decoder": "^0.7.7",
    "opus-recorder": "^8.0.5",
    "sm-crypto": "^0.3.13",
    "tbot": "file:",
    "vue": "^2.6.14",
    "vue-axios": "^3.5.2",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@playwright/test": "1.60.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "sass": "^1.32.7",
    "sass-loader": "^12.0.0",
    "vue-template-compiler": "^2.6.14",
    "webpack-bundle-analyzer": "^4.10.2",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.vue"
  ]
