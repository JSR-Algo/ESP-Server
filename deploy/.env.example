# Copy to /opt/tbot/.env on the VPS and replace every placeholder.
# Do not commit real secrets.

TZ=Asia/Ho_Chi_Minh
TBOT_REMOTE_ROOT=/opt/tbot

# Images are built locally. Use DockerHub tags for pull-based deploys, or
# local/* tags for tarball package-release deploys.
TBOT_SERVER_IMAGE=dinhmanh11/tbot-server:REPLACE_WITH_RELEASE_TAG
TBOT_WEB_IMAGE=dinhmanh11/tbot-server-web:REPLACE_WITH_RELEASE_TAG
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:8.0

# Public ports.
TBOT_WS_PORT=8000
TBOT_HTTP_PORT=8003
TBOT_ADMIN_PORT=8002

# Database.
MYSQL_DATABASE=tbot_esp32_server
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD
MYSQL_SERVER_TIMEZONE=Asia/Ho_Chi_Minh

# Redis. Leave blank only if the VPS firewall keeps Redis private to Docker.
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Manager-driven Google Live setup:
# keep this blank. Set the Google Live API key in the Admin role config page:
# https://animation-shareholders-country-these.trycloudflare.com/#/role-config?agentId=dd81bae707804544ac7404d4e389d280
#
# Only set GOOGLE_API_KEY here for non-manager local config deployments.
GOOGLE_API_KEY=
