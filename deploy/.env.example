# Copy to /opt/tbot/.env on the VPS and replace every placeholder.
# Do not commit real secrets.

TZ=Asia/Ho_Chi_Minh
NODE_ENV=production
TBOT_REMOTE_ROOT=/opt/tbot

# Images are built locally. Use DockerHub tags for pull-based deploys, or
# local/* tags for tarball package-release deploys.
TBOT_SERVER_IMAGE=dinhmanh11/tbot-server:REPLACE_WITH_RELEASE_TAG
TBOT_WEB_IMAGE=dinhmanh11/tbot-server-web:REPLACE_WITH_RELEASE_TAG
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:8.0
HAPROXY_IMAGE=haproxy:3.0-alpine

# Public ports.
TBOT_WS_PORT=8000
TBOT_HTTP_PORT=8003
TBOT_ADMIN_PORT=8002
TBOT_SERVER_REPLICAS=2

# Public device endpoints advertised by OTA/config. Use stable production
# domains; preflight rejects temporary quick tunnels.
TBOT_PUBLIC_WEBSOCKET_URL=wss://esp.tjbot.vn/tbot/v1/
TBOT_BACKEND_API_URL=https://tbot-backend-8wmh.onrender.com/v1
TBOT_SERVER_AUTH_KEY=REPLACE_WITH_SHARED_WS_HMAC_SECRET

# Database. Defaults use the in-stack MySQL service (tbot-esp32-server-db:3306,
# root). To point manager-api at an EXTERNAL / managed MySQL, set MYSQL_HOST (and
# MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD) -- no image rebuild, just restart.
MYSQL_DATABASE=tbot_esp32_server
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD
MYSQL_SERVER_TIMEZONE=Asia/Ho_Chi_Minh
# MYSQL_HOST=tbot-esp32-server-db      # external MySQL host/IP
# MYSQL_PORT=3306
# MYSQL_USER=root                       # managed MySQL usually forbids root
# MYSQL_PASSWORD=                       # defaults to MYSQL_ROOT_PASSWORD if unset

# Redis. Leave blank only if the VPS firewall keeps Redis private to Docker.
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
TBOT_LIVE_REDIS_NAMESPACE=prod
# REDIS_HOST=tbot-esp32-server-redis    # external/managed Redis host
# REDIS_PORT=6379

# Course CMS (/nestjs) backend. The web image's nginx proxies /nestjs -> this
# NestJS authoring API. Repoint the course backend by changing the host below and
# restarting (no rebuild). NESTJS_TOKEN is an optional shared author bearer token
# (a per-user in-app "Author sign-in" overrides it); leave blank to require sign-in.
NESTJS_UPSTREAM_HOST=tbot-backend-8wmh.onrender.com
# Use https for Render/external TLS; use http with tbot-cms-api:3000 on Docker.
NESTJS_UPSTREAM_SCHEME=https
NESTJS_TOKEN=
# Server-only key injected by nginx; never expose this as a VUE_APP_* variable.
NESTJS_ADMIN_PROXY_KEY=

# Manager-driven Google Live setup:
# keep this blank. Set the Google Live API key in the Admin role config page:
# https://admin.tjbot.vn/#/role-config?agentId=dd81bae707804544ac7404d4e389d280
#
# Only set GOOGLE_API_KEY here for non-manager local config deployments.
GOOGLE_API_KEY=
TBOT_GOOGLE_LIVE_ENABLED=true
TBOT_GOOGLE_LIVE_MODEL=gemini-3.1-flash-live-preview
TBOT_GOOGLE_LIVE_VOICE_NAME=Kore

# Built-in sample lesson demo bypasses backend assignment. It must remain disabled
# in production; enable it only in an isolated non-production environment.
LESSON_SAMPLE_ENABLED=false
LESSON_SAMPLE_ASSET_BASE=

# Real assigned-lesson runtime. Keep false until stable backend/device endpoints,
# shared mint secret, JWT public key, and asset origin are provisioned on BOTH
# backend and robot-server deploys.
LESSON_RUNTIME_ENABLED=false
LESSON_RENDERER_V2_ENABLED=false
LESSON_RENDERER_V4_ENABLED=false
LESSON_MOTION_PRESETS_ENABLED=false
LESSON_PLAYFUL_INTERACTIONS_ENABLED=false
# First rollout only: when runtime is enabled this must contain exactly one device
# ID/MAC. The deploy preflight rejects empty or multi-device rollout allowlists.
LESSON_ROLLOUT_DEVICE_ALLOWLIST=
# Attended HIL only: one normalized robot MAC; keep empty in normal production.
LESSON_STORAGE_HIL_DEVICE_ALLOWLIST=
COURSE_BACKEND_URL=https://tbot-backend-8wmh.onrender.com/v1
TBOT_REQUIRE_DEVICE_TOKEN=true
TBOT_DEVICE_MINT_SECRET=REPLACE_WITH_SHARED_DEVICE_MINT_SECRET
JWT_PUBLIC_KEY=REPLACE_WITH_BACKEND_JWT_PUBLIC_KEY
# Manager API verifies backend-signed child-profile projections with this key.
TBOT_PROFILE_SYNC_JWT_PUBLIC_KEY=REPLACE_WITH_PROFILE_SYNC_JWT_PUBLIC_KEY
LESSON_ASSET_ORIGIN_BASE=REPLACE_WITH_STABLE_LESSON_ASSET_ORIGIN
LESSON_ASSET_ALLOWED_ORIGINS=https://res.cloudinary.com
LESSON_SD_MAX_FILE_BYTES=33554432
LESSON_SD_MAX_PACK_BYTES=134217728
LESSON_ASSET_DELIVERY_MODE=sd_pack
# URI sent to firmware and the matching container path where packs are materialized.
LESSON_ASSET_PACK_LOCAL_ROOT=sd://tbot/lesson-assets
LESSON_ASSET_PACK_MOUNT_ROOT=/opt/tbot-esp32-server/data/lesson-packs
LESSON_VOICE_RT_P95_DISABLE_MS=1500
