# Current lab quick-tunnel endpoints.
# Source this for local/manual deploys only. These hosts rotate when cloudflared
# restarts; production deploy scripts intentionally reject trycloudflare hosts.

TBOT_ADMIN_PUBLIC_URL=https://warranty-thunder-independence-related.trycloudflare.com
TBOT_ESP_SERVER_URL=https://carefully-freelance-improving-numerical.trycloudflare.com
TBOT_OTA_URL=https://carefully-freelance-improving-numerical.trycloudflare.com/tbot/ota/
TBOT_WS_URL=wss://freebsd-concern-noon-cement.trycloudflare.com/tbot/v1/
TBOT_PUBLIC_WEBSOCKET_URL=wss://freebsd-concern-noon-cement.trycloudflare.com/tbot/v1/
TBOT_BACKEND_API_URL=https://tbot-backend-8wmh.onrender.com/v1

# Local port mapping used by the current Docker/tmux setup:
# - admin UI: 127.0.0.1:18002 -> container:8002
# - OTA/HTTP: 127.0.0.1:8003 -> container:8003
# - WebSocket: 127.0.0.1:8000 -> container:8000
