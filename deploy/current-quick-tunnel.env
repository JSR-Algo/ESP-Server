# Compatibility endpoint seed.
# This filename is retained for older local/manual scripts, but committed endpoint
# seeds must use the stable production host. Put ephemeral lab tunnel values in an
# untracked local env file instead.

TBOT_ADMIN_PUBLIC_URL=https://admin.tjbot.vn
TBOT_ESP_SERVER_URL=https://esp.tjbot.vn
TBOT_OTA_URL=https://esp.tjbot.vn/tbot/ota/
TBOT_WS_URL=wss://esp.tjbot.vn/tbot/v1/
TBOT_PUBLIC_WEBSOCKET_URL=wss://esp.tjbot.vn/tbot/v1/
TBOT_BACKEND_API_URL=https://tbot-backend-8wmh.onrender.com/v1

# Local port mapping used by the current Docker/tmux setup:
# - admin UI: 127.0.0.1:18002 -> container:8002
# - OTA/HTTP: 127.0.0.1:8003 -> container:8003
# - WebSocket: 127.0.0.1:8000 -> container:8000
