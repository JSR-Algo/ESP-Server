# Dockerfile-server-base
# Base image with system dependencies and Python packages.
FROM python:3.10-slim

# Install system dependencies.
# PR3 server-side AEC: libspeexdsp-dev + swig + build-essential are needed
# to build the speexdsp Python binding from source (no prebuilt wheel for
# aarch64 / arm64). They stay in the image so the wheel can be rebuilt on
# pip reinstall without re-running apt.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libopus0 ffmpeg locales \
        libspeexdsp-dev libspeexdsp1 swig build-essential pkg-config && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Configure pip timeout and retries.
RUN pip config set global.timeout 120 && \
    pip config set install.retries 5

# Set UTF-8 locale.
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/tbot-esp32-server

RUN groupadd -r tbot && useradd -r -g tbot -d /opt/tbot-esp32-server -s /sbin/nologin tbot

# Copy requirements.
ARG REQUIREMENTS_FILE=main/tbot-server/requirements.txt
COPY ${REQUIREMENTS_FILE} requirements.txt

# Install Python dependencies.
ARG PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG TBOT_FAST_GOOGLE_LIVE=0
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    if [ "${TBOT_FAST_GOOGLE_LIVE}" = "1" ]; then \
        pip install --no-cache-dir -r requirements.txt --default-timeout=120 --retries 5; \
    else \
        sed '/^torch==/d; /^torchaudio==/d' requirements.txt > requirements.runtime.txt && \
        pip install --no-cache-dir \
            --index-url "${PYTORCH_CPU_INDEX_URL}" \
            --trusted-host download.pytorch.org \
            torch==2.2.2+cpu torchaudio==2.2.2+cpu \
            --default-timeout=120 --retries 5 && \
        pip install --no-cache-dir -r requirements.runtime.txt --default-timeout=120 --retries 5; \
    fi && \
    rm -f requirements.runtime.txt
