# 第一阶段：构建Vue前端
ARG WEB_NODE_IMAGE=node:18
FROM ${WEB_NODE_IMAGE} AS web-builder
WORKDIR /app
COPY main/manager-web/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY main/manager-web .
ARG VUE_APP_NEST_AUTH_DISABLED=true
ENV VUE_APP_NEST_AUTH_DISABLED=$VUE_APP_NEST_AUTH_DISABLED
RUN npm run build

# 第二阶段：构建移动端H5
FROM node:20 AS mobile-builder
WORKDIR /app
RUN corepack enable
COPY main/manager-mobile/package.json main/manager-mobile/pnpm-lock.yaml main/manager-mobile/.npmrc ./
COPY main/manager-mobile/patches ./patches
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY main/manager-mobile .
RUN pnpm build:h5

# 第三阶段：构建Java后端
FROM maven:3.9.4-eclipse-temurin-21 AS api-builder
WORKDIR /app
COPY main/manager-api/pom.xml .
COPY main/manager-api/src ./src
RUN --mount=type=cache,target=/root/.m2 mvn clean package -Dmaven.test.skip=true

# 第四阶段：构建最终镜像
FROM bellsoft/liberica-runtime-container:jre-21-glibc

# 安装Nginx和字体库
RUN apk update && \
    apk add --no-cache --no-scripts \
        nginx \
        bash \
        fontconfig \
        ttf-dejavu \
    && rm -rf /var/cache/apk/* \
    && mkdir -p /run/nginx /var/log/nginx /var/tmp/nginx /etc/nginx/conf.d

# 复制项目自带的中文字体
COPY main/manager-web/public/generator/static/fonts/*.ttf /usr/share/fonts/

# 更新字体缓存
RUN fc-cache -f -v

# 配置Nginx (rendered from env at start by start.sh)
COPY docs/docker/nginx.conf /etc/nginx/nginx.conf.template

# 复制前端构建产物
COPY --from=web-builder /app/dist /usr/share/nginx/html
COPY --from=mobile-builder /app/dist/build/h5 /usr/share/nginx/html/tbot-mobile

# 复制Java后端JAR包
COPY --from=api-builder /app/target/tbot-esp32-api.jar /app/tbot-esp32-api.jar

# 暴露端口
EXPOSE 8002

# 启动脚本
COPY docs/docker/start.sh /start.sh
COPY docs/docker/cms-authority.sh /cms-authority.sh
RUN chmod +x /start.sh
CMD ["/start.sh"]
